   "source": [
    "from ultralytics import YOLO\n",
    "\n",
    "n_epochs = 100\n",
    "bs = 64\n",
    "gpu_id = 0\n",
    "validate = True\n",
    "image = 416\n",
    "model = YOLO('YOLOv8m.pt')\n",
    "results = model.train(\n",
    "    data= 'path//to//flame//data', #replace with your own data \n",
    "    epochs=n_epochs,\n",
    "    batch=bs,\n",
    "    device=gpu_id,\n",
    "    val=validate,\n",
    "    imgsz = image,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f2554e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Allow multiple OpenMP runtimes to coexist (prevents PyTorch crash on Windows) ===\n",
    "import os\n",
    "os.environ[\"KMP_DUPLICATE_LIB_OK\"] = \"TRUE\"\n",
    "\n",
    "# === Import libraries ===\n",
    "import cv2\n",
    "import numpy as np\n",
    "import platform\n",
    "import threading\n",
    "from ultralytics import YOLO\n",
    "\n",
    "# === Load fire model ===\n",
    "FIRE_MODEL_PATH = \"C:/Users/Agraw/Downloads/weights-20250331T010335Z-001/weights/best.pt\"\n",
    "CONFIDENCE_THRESHOLD = 0.4\n",
    "fire_model = YOLO(FIRE_MODEL_PATH)\n",
    "\n",
    "# === Load fire warning image (optional) ===\n",
    "FIRE_WARNING_IMAGE_PATH = \"fire_warning (2).png\"\n",
    "fire_warning_img = cv2.imread(FIRE_WARNING_IMAGE_PATH, cv2.IMREAD_UNCHANGED)\n",
    "\n",
    "# === Play beep if fire is detected (Windows only) ===\n",
    "if platform.system() == \"Windows\":\n",
    "    import winsound\n",
    "    def play_beep():\n",
    "        winsound.Beep(2000, 500)\n",
    "\n",
    "# === Overlay transparent PNG onto background ===\n",
    "def overlay_transparent(bg, overlay, x, y, max_width=None, max_height=None):\n",
    "    def resize_with_aspect_ratio(image, max_width=None, max_height=None, inter=cv2.INTER_AREA):\n",
    "        h, w = image.shape[:2]\n",
    "        if max_width is None and max_height is None:\n",
    "            return image\n",
    "        if max_width is None:\n",
    "            r = max_height / float(h)\n",
    "            dim = (int(w * r), max_height)\n",
    "        elif max_height is None:\n",
    "            r = max_width / float(w)\n",
    "            dim = (max_width, int(h * r))\n",
    "        else:\n",
    "            r = min(max_width / float(w), max_height / float(h))\n",
    "            dim = (int(w * r), int(h * r))\n",
    "        return cv2.resize(image, dim, interpolation=inter)\n",
    "\n",
    "    if overlay is None:\n",
    "        return bg\n",
    "    overlay = resize_with_aspect_ratio(overlay, max_width, max_height)\n",
    "    h, w = overlay.shape[:2]\n",
    "    if x + w > bg.shape[1] or y + h > bg.shape[0]:\n",
    "        return bg\n",
    "    if overlay.shape[2] < 4:\n",
    "        bg[y:y+h, x:x+w] = overlay\n",
    "    else:\n",
    "        overlay_color = overlay[:, :, :3]\n",
    "        mask = overlay[:, :, 3]\n",
    "        mask_inv = cv2.bitwise_not(mask)\n",
    "        roi = bg[y:y+h, x:x+w]\n",
    "        img_bg = cv2.bitwise_and(roi, roi, mask=mask_inv)\n",
    "        overlay_fg = cv2.bitwise_and(overlay_color, overlay_color, mask=mask)\n",
    "        dst = cv2.add(img_bg, overlay_fg)\n",
    "        bg[y:y+h, x:x+w] = dst\n",
    "    return bg\n",
    "\n",
    "# === Initialize video capture ===\n",
    "cap = cv2.VideoCapture(1)\n",
    "fire_beep_played = False\n",
    "\n",
    "while True:\n",
    "    ret, frame = cap.read()\n",
    "    if not ret:\n",
    "        continue\n",
    "\n",
    "    fire_frame = frame.copy()\n",
    "    fire_detected = False\n",
    "\n",
    "    # === Run fire detection model ===\n",
    "    results = fire_model.track(source=fire_frame, stream=True, conf=CONFIDENCE_THRESHOLD)\n",
    "    for result in results:\n",
    "        for box in result.boxes:\n",
    "            if box.conf[0] > CONFIDENCE_THRESHOLD:\n",
    "                cls = int(box.cls[0])\n",
    "                class_name = result.names[cls]\n",
    "                x1, y1, x2, y2 = map(int, box.xyxy[0])\n",
    "\n",
    "                # Draw bounding box\n",
    "                cv2.rectangle(fire_frame, (x1, y1), (x2, y2), (0, 165, 255), 2)\n",
    "                cv2.putText(fire_frame, class_name, (x1, y1 - 10),\n",
    "                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 165, 255), 2)\n",
    "\n",
    "                # Trigger alert if class is 'fire'\n",
    "                if class_name.lower() == \"fire\":\n",
    "                    fire_detected = True\n",
    "\n",
    "    # === Fire alert visuals and audio ===\n",
    "    if fire_detected:\n",
    "        if not fire_beep_played:\n",
    "            threading.Thread(target=play_beep).start()\n",
    "            fire_beep_played = True\n",
    "        fire_frame = overlay_transparent(fire_frame, fire_warning_img, fire_frame.shape[1] - 160, 10, 150, 150)\n",
    "        cv2.putText(fire_frame, \"WARNING FIRE!\", (fire_frame.shape[1] - 250, 180),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 3)\n",
    "    else:\n",
    "        fire_beep_played = False\n",
    "\n",
    "    # === Display output ===\n",
    "    cv2.imshow(\"Flame Detection\", fire_frame)\n",
    "\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "# === Cleanup ===\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()\n"
   ]
  },
 ],
